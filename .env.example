# Server listen address.
ADDR=:2760

# Should the server serve the web frontend? Set to false in production.
DEV_MODE=false

# Scrape cron schedule (Monday 05:00 local time by default).
SCRAPE_CRON_SCHED=0 5 * * 1

# Delay between the ~20 search API requests in a full scrape. The SIK API
# robots.txt allows all paths, but a small delay is still polite.
SCRAPE_DELAY=10s

# SIK search API contract version. Leave empty to use the version built into
# the binary (20260727); bump it here if IKEA changes the API.
IKEA_API_VERSION=
